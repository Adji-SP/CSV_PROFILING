# Copy this file to .env and replace placeholders with values for your machine.
# Never commit .env. The scripts/dev.ps1 Tunnel profile overrides the listener
# addresses and ports below in its own process; ordinary run-dev.bat uses them.
# Rust OTA listener. 0.0.0.0 is required for LAN devices.
OTA_BIND_ADDRESS=0.0.0.0
OTA_PORT=7000

# Optional Cloudflare development profile: scripts/dev.ps1 sets these process
# variables to 127.0.0.1:5173 and 127.0.0.1:8080 without changing normal local runs.
# CSV_BIND_ADDRESS=127.0.0.1
# CSV_PORT=5173
# OTA_BIND_ADDRESS=127.0.0.1
# OTA_PORT=8080
# Flask serves one browser-safe API setting at /app-config.js.
# APP_LOCAL_OTA_API_BASE_URL=http://localhost:8080
# APP_PUBLIC_FRONTEND_HOST=dev.iot-prototype.net
# APP_PUBLIC_OTA_API_BASE_URL=https://api-dev.iot-prototype.net

# REQUIRED FOR LAN DEVICES: use this PC's current LAN IP and Rust listener port,
# never localhost. Update it when your network or -ApiPort changes.
OTA_PUBLIC_BASE_URL=http://192.168.1.5:7000

# Relative paths are resolved from the repository root.
OTA_PROJECT_DIR=firmware-projects
OTA_BUILD_DIR=firmware-builds
OTA_DATA_DIR=data
# Stable ESP32 runtime used to compose managed application uploads.
OTA_RUNTIME_DIR=examples/esp32-rust-ota-client

# ESP-IDF's native Windows build rejects long output paths. On Windows this
# must be an absolute, writable path no longer than 10 characters. It may be
# omitted on Linux/macOS.
OTA_CARGO_TARGET_DIR=C:/ota

# Optional but strongly recommended for native Windows ESP-IDF builds. Keep
# the ESP-IDF checkout/cache out of long uploaded-project paths.
OTA_ESP_IDF_TOOLS_DIR=C:/esp-idf
OTA_PYTHON_PATH=C:/Python311/python.exe

OTA_MAX_UPLOAD_MB=50
OTA_MAX_EXTRACTED_MB=500
OTA_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173,https://dev.iot-prototype.net
# scripts/dev.ps1 supplies the same origins process-locally if not already set.

# Espressif Rust toolchain installed by espup. Set empty to use the default.
OTA_RUST_TOOLCHAIN=esp

# Embedded values used when composing managed firmware. Keep real credentials
# only in the ignored .env file, never in source archives or version control.
WIFI_SSID=your-wifi-name
WIFI_PASS=your-wifi-password
DEVICE_NAME=ESP32-S3 Managed Device
# Optional; leave unset to derive a stable device ID from the station MAC.
# DEVICE_ID=ESP32-S3-001

# Optional logging override.
RUST_LOG=info,tower_http=info

# These old hosting details are NOT read by Flask, Axum, or the Tunnel launcher.
# Keep any real SSH password in a private password manager, not this example.
# SSH_ACCESS="ssh -p YOUR_PORT YOUR_USER@YOUR_HOST"
# SSH_PASSWORD=REPLACE_WITH_PRIVATE_SECRET
# URL_DOMAIN=https://your-hosting-domain.example/

# Optional PostgreSQL (omit to keep existing SQLite). Use verify-full on Azure.
# DATABASE_URL=postgresql://ota:password@localhost:5432/ota
# Remote console viewer token: generate a random value with at least 32 chars.
# CONSOLE_VIEWER_TOKEN=
# Hosted read-only instance: excludes build, upload, device write and OTA routes.
# OTA_CONSOLE_ONLY=true
# Backend MQTT identity: subscribe-only ACL for devices/+/logs.
# MQTT_HOST=your-namespace.region.ts.eventgrid.azure.net
# MQTT_PORT=8883
# MQTT_USERNAME=console-backend
# MQTT_PASSWORD=
# MQTT_CA_FILE=/run/secrets/root-ca.pem
# MQTT_CERT_FILE=/run/secrets/backend-cert.pem
# MQTT_KEY_FILE=/run/secrets/backend-key.pem

# Firmware identity is DIFFERENT from the backend identity. One board per build.
# DEVICE_ID=ESP32-S3-001
# DEVICE_MQTT_URL=mqtts://YOUR_PC_LAN_IP:8883
# DEVICE_MQTT_USERNAME=ESP32-S3-001
# DEVICE_MQTT_PASSWORD=
# PEM values must be quoted multiline strings. Never upload private keys in ZIPs.
# DEVICE_MQTT_CA_PEM=
# DEVICE_MQTT_CERT_PEM=
# DEVICE_MQTT_KEY_PEM=

# TinyML uses the same backend MQTT TLS connection, viewer token and SQL database.
# Extend broker ACLs: backend subscribes to tinyml/v1/#; each device publishes
# ONLY tinyml/v1/<its-device-id>/#. Keep devices/+/logs for Remote Console.
TINYML_MQTT_ENABLED=true
TINYML_MQTT_TOPIC_PREFIX=tinyml/v1
TINYML_MAX_MESSAGE_BYTES=65536
TINYML_RUN_TIMEOUT_SECONDS=300
